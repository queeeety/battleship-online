@startuml MyBattleship_UseCase_Overview
title MyBattleship - Use Case Overview

left to right direction
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 70
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #33567F
}
skinparam actorStyle awesome

actor Player
actor Host
actor Guest
actor Timer

Player <|-- Host
Player <|-- Guest

rectangle "MyBattleship System" {

  package "Setup" {
    usecase "Play vs AI" as UC_AI
    usecase "Choose Difficulty" as UC_Diff
    usecase "Create Lobby" as UC_Create
    usecase "Choose Game Type" as UC_Type
    usecase "Share Lobby Code" as UC_Share
    usecase "Join Lobby" as UC_Join
    usecase "Join by Code" as UC_JoinCode
    usecase "Join by Link" as UC_JoinLink
    usecase "Enter Display Name" as UC_Name
    usecase "Place Fleet" as UC_Place
    usecase "Randomise Placement" as UC_Rand
  }

  package "Battle" {
    usecase "Take Turn" as UC_Turn
    usecase "Fire Shot" as UC_Fire
    usecase "Use Ability" as UC_Ability
    usecase "Keep or Replace Ability" as UC_Keep
    usecase "Forfeit" as UC_Forfeit
    usecase "Game Over / Rematch" as UC_Result
  }

  package "Resilience" {
    usecase "Restore Seat" as UC_Restore
    usecase "Auto-fire on Timeout" as UC_Auto
    usecase "Award Win on Disconnect" as UC_DC
  }
}

' ---------- Actor associations ----------
Player -- UC_AI
Player -- UC_Place
Player -- UC_Turn
Player -- UC_Keep
Player -- UC_Forfeit
Player -- UC_Result
Player -- UC_Restore
Host -- UC_Create
Guest -- UC_Join
Timer -- UC_Auto
Timer -- UC_DC

' ---------- Include ----------
UC_AI ..> UC_Place : <<include>>
UC_AI ..> UC_Turn : <<include>>
UC_Create ..> UC_Type : <<include>>
UC_Turn ..> UC_Result : <<include>>
UC_Auto ..> UC_Fire : <<include>>

' ---------- Extend ----------
UC_Diff .> UC_AI : <<extend>>
UC_Share .> UC_Create : <<extend>>
UC_Name .> UC_Create : <<extend>>
UC_Name .> UC_Join : <<extend>>
UC_Rand .> UC_Place : <<extend>>
UC_Fire .> UC_Turn : <<extend>>
UC_Ability .> UC_Turn : <<extend>>
UC_Keep .> UC_Turn : <<extend>>

' ---------- Generalisation ----------
UC_Join <|-- UC_JoinCode
UC_Join <|-- UC_JoinLink

legend right
  |= Use case |= Note |
  | Enter Display Name | Optional. Not needed for AI mode; spec assumes none for multiplayer (conflicts with tech design doc) |
  | Use Ability | On your own turn, before firing. Scans and Reroute use the turn's shot; Double Shot does not |
  | Keep or Replace Ability | Only when a ship of yours is sunk while you already hold an ability |
  | Fire Shot | Skipped when an ability has used the turn's shot. A hit fires again; a miss passes the turn |
  | Auto-fire on Timeout | Random shot when the game type's limit runs out (30 / 15 / 5 s); paused while the player is away |
  | Award Win on Disconnect | 60 s with no presence during battle |
  | Play vs AI | AIOpponent is a Player subclass inside the system, not an actor. Abilities are always on |
endlegend

@enduml