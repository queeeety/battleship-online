@startuml 4_4_TurnCycle_SubStateDiagram
' MyBattleship -- GroupXXAssign2.pdf, section 4.4: Turn Cycle (sub-state diagram)
' Expands the InProgress composite state of section 4.1 (Game). Covers UC3 Fire Shot and UC4 Use Ability.
title MyBattleship -- Game::InProgress Turn Cycle (Sub-State Machine)

hide empty description
skinparam nodesep 55
skinparam ranksep 75
skinparam padding 5
skinparam defaultFontSize 13
skinparam ArrowFontSize 12
skinparam StateFontSize 14
skinparam StateAttributeFontSize 12
skinparam state {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

state "Game :: InProgress" as InProgress {

  [*] --> AwaitingAction : beginBattle()\n[currentTurn chosen at random]\n/ turnStartedAt = now

  state AwaitingAction : entry / start turn timer (30/15/5 s)

  state ResolvingShot : do / Board.receiveShot(target, shooter)
  state ResolvingShot : exit / turnStartedAt = now
  state ApplyingAbility : do / Ability.apply()
  state GrantingAbility : do / Game.grantAbility(owner)
  state SwitchingTurn : do / switchTurn()
  state TurnPaused : entry / timer paused
  state ActionRejected : do / UIManager.showError()

  AwaitingAction --> ActionRejected : fireShot(target)\n[Board.hasBeenTargeted(target)]\n/ no shot fired
  AwaitingAction --> ResolvingShot : fireShot(target)\n[shooter == currentTurn\nand not hasBeenTargeted(target)]
  AwaitingAction --> ResolvingShot : claimTimeout() or next fireShot()\n[isTurnExpired()\nand player connected]\n/ fireRandomShot(currentTurn)
  AwaitingAction --> ApplyingAbility : useAbility(a, target)\n[heldAbility != null\nand a.canUse(g)\nand a.isValidTarget(b, target)]
  AwaitingAction --> ActionRejected : useAbility(a, target)\n[not a.isValidTarget(b, target)]\n/ ability not consumed
  AwaitingAction --> TurnPaused : reportDisconnect()\n[p == currentTurn]\n/ p.disconnect()

  ActionRejected --> AwaitingAction : errorAcknowledged\n[turn unchanged]\n/ player chooses again

  TurnPaused --> AwaitingAction : getMyState() by p\n[within 60 s]\n/ p.reconnect(), resumeTurnTimer(awayMs)
  TurnPaused --> [*] : claimTimeout()\n[p gone > 60 s]\n/ declareWinner(opponent,\nOPPONENT_DISCONNECTED)

  ResolvingShot --> AwaitingAction : shotResolved(result)\n[result == HIT and not allShipsSunk()]\n/ same player fires again
  ResolvingShot --> GrantingAbility : shotResolved(result)\n[result == SUNK and not allShipsSunk()]
  ResolvingShot --> AwaitingAction : shotResolved(result)\n[result == MISS and doubleShotActive]\n/ doubleShotActive = false, turn continues
  ResolvingShot --> SwitchingTurn : shotResolved(result)\n[result == MISS and not doubleShotActive]
  ResolvingShot --> [*] : shotResolved(result)\n[allShipsSunk()]\n/ declareWinner(shooter, FLEET_DESTROYED)

  GrantingAbility --> AwaitingAction : abilityGranted\n[kept or replaced by owner]\n/ sinking was a hit, shooter fires again

  ApplyingAbility --> SwitchingTurn : abilityApplied(a)\n[a.usesTurnShot]\n/ RadarSweep, LineScan, Reroute
  ApplyingAbility --> AwaitingAction : abilityApplied(a)\n[not a.usesTurnShot]\n/ DoubleShot: doubleShotActive = true,\nplayer still fires

  SwitchingTurn --> AwaitingAction : switchTurn()\n[game not finished]\n/ currentTurn = opponent,\nturnStartedAt = now
}

legend bottom
  Guards trace to UC3 (a hit fires again, a miss passes the turn, already-targeted
  squares rejected, timer auto-fire, 60 s disconnect) and UC4 (abilities are used
  before firing; DoubleShot does not consume the turn's shot).
  The turn clock restarts after every resolved shot, so a fire-again shot after a hit
  gets the full 30/15/5 s.
endlegend
@enduml
