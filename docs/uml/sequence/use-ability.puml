@startuml 5_4_UseAbility_SequenceDiagram
' MyBattleship -- GroupXXAssign2.pdf, section 5.4: Use Ability
' Scenario: UC4 Use Ability, scenarios 2.6, 2.7 and 2.8. Referenced from 5.3 Fire Shot.
title UC4 Use Ability -- Grant, Keep or Replace, and Apply (Sequence Diagram, UML 2.x)

skinparam sequenceMessageAlign first
autonumber

actor "Aoife\n(ability holder)" as Owner
boundary "ownerUI : UIManager" as UI
control "server : Server" as Server
database "repo : GameRepository" as Repo
control "game : Game" as Game
entity "owner : Player" as Player
entity "ability : Ability" as Ability
entity "ownBoard : Board" as OwnBoard
entity "oppBoard : Board" as OppBoard
boundary "net : NetworkHandler" as Net
boundary "oppUI : UIManager" as OppUI

group Grant (inside 5.3 Fire Shot, when one of the owner's Ships is sunk)
  Game -> Game : grantAbility(owner)
  activate Game
  loop while drawn == Reroute and Reroute.validPositions(ownBoard, s).isEmpty() for every undamaged Ship
    Game -> Game : draw again from the other three
    note right of Game : UC4 1a
  end
  Game -> Ability : <<create>> RadarSweep
  Game -> Player : receiveAbility(drawn)
  alt owner.heldAbility == null
    Player --> Game : held
  else owner already holds an unused ability
    Player --> Game : kept as offeredAbility
  end
  deactivate Game
  Repo -> Net : game_updated (database trigger, no ability columns)
  Net --> OppUI : SUNK result: "[Name] was granted an ability"

  opt owner already holds an unused ability
    Server -> Net : sendPrivate(owner, abilityOffer {current, drawn})
    note right of Server : Sent by fireShot once the shot is saved
    Net --> UI : promptKeepOrReplace(current, drawn)
    UI --> Owner : "Keep current or take drawn?"
    Owner -> UI : selects Keep (or no choice in 10 s)
    UI -> Server : chooseAbility(code, true)
    activate Server
    Server -> Repo : loadGame(code) : game, version
    Server -> Player : resolveOffer(keep)
    note right of Player : UC4 2a: exactly one\nability is held afterwards
    Server -> Repo : saveGame(game, version)
    deactivate Server
  end
end

group Use (on the holder's own turn, before firing)
  Owner -> UI : selects Radar Sweep, aims at F5 (area E4-G6)
  activate UI
  UI -> Server : useAbility(code, {name: "Radar Sweep"}, E4)
  note right of UI : Radar Sweep is aimed by its middle;\nthe request carries the area's top left
  activate Server
  Server -> Repo : loadGame(code) : game, version, scanLog
  Server -> Server : fireIfTurnExpired(game)
  note right of Server : An expired turn gets its\nrandom shot first (5.3)
  opt an offer is still pending
    Server -> Player : resolveOffer(true)
    note right of Player : Using the held ability\ncounts as keeping it
  end
  Server -> Player : getHeldAbility()
  Player --> Server : ability (must match the request)
  note right of Server : Line Scan: setDirection(row or column)\nReroute: selectShip(ship), setOrientation(o)
  Server -> Game : applyAbility(owner, E4)
  activate Game
  Game -> Ability : canUse(game)
  Ability --> Game : owner's turn, before firing, not used

  alt not ability.isValidTarget(oppBoard, E4)
    Game --> Server : invalid target
    Server --> UI : MOVE_REFUSED, ability kept
    UI --> Owner : choose another target (UC4 4b)
  else valid target
    Game -> Ability : apply(game, oppBoard, E4)
    activate Ability
    alt ability is RadarSweep
      Ability -> OppBoard : scanArea(E4, 3)
      OppBoard --> Ability : [F5, F6] unshot ship squares
    else ability is LineScan
      Ability -> OppBoard : scanLine(index, isRow)
      OppBoard --> Ability : unshot ship squares on that line
    else ability is Reroute
      Ability -> OwnBoard : validPositions(ownBoard, ship)
      Ability -> OwnBoard : moveShip(ship, start, orientation)
      note right of OwnBoard : Destination excludes every square\nthe opponent has already fired at,\nand keeps a free square around\nthe other ships
    else ability is DoubleShot
      Ability -> Game : doubleShotActive = true
    end
    Ability --> Game : applied, used = true
    deactivate Ability
    Game -> Player : consumeAbility()

    alt ability.usesTurnShot
      Game -> Game : switchTurn()
      note right of Game : Scans and Reroute consume\nthe turn's shot (UC4 7)
    else not ability.usesTurnShot
      Game -> Game : turn continues, player still fires
      ref over Game : 5.3 Fire Shot
    end
    Game --> Server : applied
    deactivate Game

    Server -> Server : scanLog: add [F5, F6] for owner
    note right of Server : A rerouted ship's old squares\nleave the opponent's scanLog
    Server -> Repo : saveGame(game, version, code, scanLog)
    activate Repo
    alt another save landed first (double-click, second tab)
      Repo --> Server : StaleGameError, nothing written
      Server --> UI : STALE
    else saved
      Repo -> Net : game_updated (database trigger on games)
      deactivate Repo
      Server -> Net : sendPrivate(owner, scanResult [F5, F6])
      activate Net
      Net --> UI : showScanResult([F5, F6])
      Server -> Net : sendPrivate(opponent, abilityUsed {by, ability})
      Net --> OppUI : "[Name] used Radar Sweep"
      note right of OppUI : The opponent never learns\nwhat the scan revealed (1.2)
      deactivate Net
      Server --> UI : ok
    end
  end
  deactivate Server
  UI --> Owner : green scan markers on F5, F6\n(getMyState.revealedSquares, until shot)
  deactivate UI
end

opt holder is the AIOpponent
  Player -> Player : takeTurn(game)\n[shouldUseAbility() and ability.canUse(game)]
  Player -> Game : applyAbility(owner, chooseAbilityTarget())
  note right of Game : UC4 3a: the computer decides\nby the same rules. With no target,\nor a rejected one, it fires instead.\nAI mode runs in the browser, no Server
end
@enduml
