@startuml 5_1_StartGame_SequenceDiagram
' MyBattleship -- GroupXXAssign2.pdf, section 5.1: Start Game
' Scenario: UC1 Start Game (Create Lobby, Join Lobby, Play vs AI), scenarios 2.1 and 2.2.
title UC1 Start Game -- Create Lobby, Join Lobby or Play vs AI (Sequence Diagram, UML 2.x)

skinparam sequenceMessageAlign first
autonumber

actor "Cian\n(host)" as Host
boundary "hostUI : UIManager" as HostUI
control "server : Server" as Server
control "lobby : Lobby" as Lobby
control "game : Game" as Game
database "repo : GameRepository" as Repo
boundary "net : NetworkHandler" as Net
boundary "guestUI : UIManager" as GuestUI
actor "Aoife\n(guest)" as Guest
entity "ai : AIOpponent" as AI

alt#Gold #WhiteSmoke multiplayer: host selects Create Lobby

Host -> HostUI : enters name "Cian91", selects Create Lobby
activate HostUI
HostUI -> Server : createLobby(name, ORIGINAL)
activate Server
Server -> Server : callerSessionId()\n(anonymous sign-in if new)

alt name length > 16
  Server --> HostUI : JoinError.INVALID_NAME
  HostUI --> Host : showError(INVALID_NAME)
else name blank
  Server -> Server : assignRandomName()
end

loop while code already in use
  Server -> Lobby : <<create>> Lobby(gameType)
  activate Lobby
  Lobby -> Lobby : generateCode()
  Lobby -> Game : <<create>> Game(gameType)
  activate Game
  Server -> Repo : loadLobby(code)
  Repo --> Server : null (code free)
end
Server -> Lobby : join("Cian91", sessionId)
Lobby -> Game : addPlayer(hostPlayer)
Lobby --> Server : hostPlayer : HumanPlayer
Server -> Repo : saveLobby(lobby)
Server --> HostUI : lobby, sessionId
deactivate Server
HostUI -> Net : subscribe("4F7K2M")
activate Net
HostUI --> Host : showScreen(Lobby), shareLink()
deactivate HostUI

Guest -> GuestUI : enters code "4F7K2M", leaves name blank
activate GuestUI
GuestUI -> Server : joinLobby("4F7K2M", "")
activate Server
Server -> Server : callerSessionId()
Server -> Repo : loadLobby("4F7K2M")
Repo --> Server : lobby

alt lobby not found or abandoned
  Server --> GuestUI : JoinError.CODE_NOT_FOUND
  GuestUI --> Guest : showError("Lobby not found")
else caller already holds a seat
  Server --> GuestUI : lobby, existing seat
else lobby.status == FINISHED
  Server --> GuestUI : JoinError.GAME_ALREADY_FINISHED
  GuestUI --> Guest : showError("Game has ended")
else not lobby.isJoinable()
  Server --> GuestUI : JoinError.LOBBY_FULL
  GuestUI --> Guest : showError("Lobby is full")
else lobby.isJoinable()
  Server -> Server : assignRandomName() : "Player482"
  Server -> Lobby : join("Player482", sessionId)
  Lobby -> Game : addPlayer(guestPlayer)
  Game --> Lobby : state = PLACEMENT
  Lobby --> Server : guestPlayer : HumanPlayer
  Server -> Repo : seatGuest(lobby)
  note right of Repo : Only if seat 2 is still empty
  opt another guest got seat 2 first
    Repo --> Server : false
    Server --> GuestUI : JoinError.LOBBY_FULL
  end
  Repo -> Net : game_updated (database trigger on games)
  Net --> HostUI : onBroadcast, onState(getMyState) : both players seated
  Net --> GuestUI : onBroadcast, onState(getMyState) : both players seated
  Server --> GuestUI : lobby, sessionId
  deactivate Server
  GuestUI --> Guest : showScreen(Placement)
end
deactivate GuestUI

opt player reloads the page
  GuestUI -> Server : restoreSeat()
  activate Server
  Server -> Repo : findActiveLobbyCode(sessionId)
  Repo --> Server : "4F7K2M"
  Server -> Repo : loadLobby("4F7K2M")
  Repo --> Server : lobby
  Server --> GuestUI : lobby, player
  deactivate Server
  GuestUI -> Server : getMyState(code)
  Server --> GuestUI : game
  note right of GuestUI : Seat matched by the session cookie,\nnever by display name or a value\nthe browser sends (UC1 *a)
end

ref over HostUI, GuestUI, Game : UC2 Place Fleet

deactivate Net
deactivate Lobby
deactivate Game

else single player: host selects Play vs AI (UC1 3a)

Host -> HostUI : selects Play vs AI, chooses NORMAL difficulty
activate HostUI
note right of HostUI : No name, lobby, code or Server:\nthe Game runs in the browser (4.7)
HostUI -> Game : <<create>> Game(gameType)
activate Game
HostUI -> AI : <<create>> AIOpponent(NORMAL)
activate AI
Game -> Game : addPlayer(humanPlayer)
Game -> Game : addPlayer(ai)
AI -> AI : placeFleetRandomly()
note right of AI : Same Board method as the\nRandomise button (UC2 *a)
Game --> HostUI : state = PLACEMENT
HostUI --> Host : showScreen(Placement)
deactivate HostUI

ref over HostUI, Game : UC2 Place Fleet

deactivate AI
deactivate Game
end
@enduml
