@startuml FireShot_UseCaseClassDiagram
title Use Case: Fire Shot (incl. Auto-fire on Timeout) - Participating Classes

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

enum ShotResult {
  MISS
  HIT
  SUNK
}

enum CellState {
  EMPTY
  OCCUPIED
  HIT
  MISS
}

enum GameState {
  PLACEMENT
  IN_PROGRESS
  FINISHED
}

enum GameType {
  BEGINNER
  ORIGINAL
  QUICK_FIRE
}

class UIManager <<boundary>> {
  + onCellClick(c : Coordinate) : void
  + renderBoard(b : Board, isOwn : boolean) : void
  + showCountdown(secondsLeft : int) : void
}

class NetworkHandler <<boundary>> {
  - channel : Channel
  + broadcast(g : Game) : void
}

class Server <<controller>> {
  + fireShot(code : String, target : Coordinate) : Shot
}

class Game <<controller>> {
  - state : GameState
  - gameType : GameType
  - currentTurn : Player
  - turnStartedAt : DateTime
  + fireShot(shooter : Player, target : Coordinate) : Shot
  + fireRandomShot(p : Player) : Shot
  + isTurnExpired(now : DateTime = now) : boolean
  + switchTurn() : void
  + grantAbility(p : Player) : void
  + checkWinCondition() : boolean
}

abstract class Player <<entity>> {
  - id : UUID
  - name : String
  + {abstract} chooseTarget() : Coordinate
  + hasLost() : boolean
}

class HumanPlayer <<entity>> {
  + chooseTarget() : Coordinate
}

class AIOpponent <<entity>> {
  - huntQueue : List<Coordinate>
  + chooseTarget() : Coordinate
  - hunt() : Coordinate
  - target() : Coordinate
}

class Board <<entity>> {
  + receiveShot(target : Coordinate, shooter : Player) : Shot
  + hasBeenTargeted(c : Coordinate) : boolean
  + allShipsSunk() : boolean
}

class Cell <<entity>> {
  - state : CellState
  + isAlreadyShot() : boolean
  + markHit() : void
  + markMiss() : void
}

abstract class Ship <<entity>> {
  - name : String
  - hits : int
  # length : int
  + registerHit() : void
  + isSunk() : boolean
}

class Shot <<entity>> {
  - coordinate : Coordinate
  - result : ShotResult
  - shooter : Player
  - firedAt : DateTime
  - sunkShipName : String
  + isHit() : boolean
}

' ---------- Relationships exercised by this use case ----------
UIManager ..> Server : fireShot >
Server ..> Game : resolves in one transaction >
Server --> NetworkHandler : broadcasts result >
NetworkHandler ..> UIManager : pushes to both clients >

Game "1" o-- "2" Player : players >
Game "1" *-- "0..*" Shot : records >
Game --> GameState
Game --> GameType

Player <|-- HumanPlayer
Player <|-- AIOpponent
Player "1" *-- "1" Board : owns >

Board "1" *-- "100" Cell : consists of >
Board "1" o-- "5" Ship : fleet >
Board ..> Shot : creates >

Cell --> CellState
Cell "*" --> "0..1" Ship : holds >
Shot --> ShotResult
Shot "*" --> "1" Player : fired by >

note bottom of Game
  Server-authoritative: turn ownership,
  shot resolution and win check run once
  per shot, so they live on the server
  (brief, 3.2.1). A hit keeps the turn,
  a miss calls switchTurn(). If
  isTurnExpired() (30/15/5 s by GameType),
  fireRandomShot() fires for the player.
  A SUNK result calls grantAbility().
end note

note bottom of AIOpponent
  Single-player only. Runs client-side:
  only one client needs this logic.
end note

@enduml
