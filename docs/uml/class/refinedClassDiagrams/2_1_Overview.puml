@startuml 2_1_Overview
title Figure 2.1 - Overview: classes and structural relationships (members and dependencies in Figures 2.2-2.7)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 70
skinparam dpi 150
hide members
hide circle

package "Client (browser)" {
  class UIManager <<boundary>>
  class BoardView <<boundary>>
  class CellView <<boundary>>
  class ShipPlacer <<boundary>>
  class TurnBanner <<boundary>>
  class AbilityCard <<boundary>>
  class ResultScreen <<boundary>>
  class Timer <<boundary>>
  class NetworkHandler <<boundary>>
}
package "Server (server actions)" {
  class Server <<controller>>
  class RequestValidator <<utility>>
  class SessionManager <<utility>>
  class RateLimiter <<utility>>
  class GameRepository <<persistence>>
}
package "Domain: game" {
  class Lobby <<controller>>
  class Game <<controller>>
  class Shot <<entity>>
  class RematchRequest <<entity>>
  class GameResult <<entity>>
  abstract class Player <<entity>>
  class HumanPlayer <<entity>>
  class AIOpponent <<entity>>
}
package "Domain: board and fleet" {
  class Board <<entity>>
  class Cell <<entity>>
  abstract class Ship <<entity>>
  class Carrier 
  class Battleship 
  class Cruiser 
  class Submarine 
  class Destroyer 
  class Coordinate <<value>>
}
package "Abilities" {
  abstract class Ability <<entity>>
  class RadarSweep 
  class LineScan 
  class DoubleShot 
  class Reroute 
}

