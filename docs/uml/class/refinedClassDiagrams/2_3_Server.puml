@startuml 2_3_Server
title Figure 2.3 - Server (server actions) and its helpers
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 45
skinparam linetype ortho
skinparam dpi 150
hide empty members

RequestValidator -[hidden]down- SessionManager
RateLimiter -[hidden]down- GameRepository
class Server <<controller>> {
  - repo : GameRepository
  - validator : RequestValidator
  - sessions : SessionManager
  - limiter : RateLimiter
  - {static} MAX_CODE_TRIES : number = 10
  - {static} MAX_SAVE_TRIES : number = 3
  + {static} create() : Promise<Server>
  + createLobby(name : unknown, type : unknown) : Promise<Lobby>
  + joinLobby(code : unknown, name : unknown) : Promise<{lobby : Lobby, player : HumanPlayer}>
  + placeShips(code : unknown, layout : unknown) : Promise<boolean>
  + fireShot(code : unknown, target : unknown) : Promise<Shot>
  + useAbility(code : string, a : Ability, target : Coordinate) : void
  + chooseAbility(code : string, keep : boolean) : void
  + claimTimeout(code : string) : void
  + forfeit(code : unknown) : Promise<void>
  + requestRematch(code : string, accept : boolean) : RematchRequest
  + getMyState(code : unknown) : Promise<PlayerView>
  + restoreSeat(sessionId? : string) : Promise<{lobby : Lobby, player : HumanPlayer} | null>
  - assignRandomName() : string
  - callerSessionId() : Promise<string>
  - checkRateLimit(sessionId : string, action : string) : Promise<void>
  - validName(raw : unknown) : string
  - seatedCaller(code : unknown) : Promise<{lobbyCode, lobby, seat, player}>
  - loadStarted(code : string) : Promise<LoadedGame>
  - retryIfStale(code : string, fn : () => Promise<boolean>) : Promise<true>
  - {static} viewFor(lobby : Lobby, game : Game | null, seat : 1 | 2) : PlayerView
}
class RequestValidator <<utility>> {
  - codeSchema : ZodSchema
  - nameSchema : ZodSchema
  - coordinateSchema : ZodSchema
  - layoutSchema : ZodSchema
  - gameTypeSchema : ZodSchema
  + parseCode(raw : unknown) : string
  + parseName(raw : unknown) : string | null
  + parseCoordinate(raw : unknown) : Coordinate
  + parseLayout(raw : unknown) : Board
  + parseGameType(raw : unknown) : GameType
}
class SessionManager <<utility>> {
  - client : SupabaseClient
  + {static} create() : Promise<SessionManager>
  + signInAnonymously() : Promise<string>
  + currentSessionId() : Promise<string | null>
  + verifySeat(code : string, sessionId : string) : Promise<boolean>
}
class RateLimiter <<utility>> {
  - maxRequests : number
  - windowMs : number
  - ratelimit : Ratelimit | null
  + allow(sessionId : string, action : string) : Promise<boolean>
}
class GameRepository <<persistence>> {
  - client : SupabaseClient
  + loadLobby(code : string) : Promise<Lobby | null>
  + saveLobby(l : Lobby) : Promise<void>
  + findActiveLobbyCode(sessionId : string) : Promise<string | null>
  + loadGame(code : string) : Promise<LoadedGame | null>
  + saveGame(g : Game, version : string) : Promise<string | null>
  + loadFleet(code : string, p : Player) : Promise<Board>
  + saveFleet(code : string, p : Player, b : Board) : Promise<boolean>
  + runShotTransaction(code : string, shooter : Player, target : Coordinate) : Promise<Shot>
}
class LoadedGame <<value>> {
  + game : Game
  + version : string
}
class PlayerView <<value>> {
  + code : string
  + seat : 1 | 2
  + gameState : GameState | null
  + yourTurn : boolean
  + yourBoard : BoardSnapshot
  + yourShots : ShotView[]
  + opponentShots : ShotView[]
  + heldAbility : string | null
  + offeredAbility : string | null
  + opponentBoard : BoardSnapshot | null
  + result : {won, shotsFired, accuracy, shipsSunk} | null
}
class ShotView <<value>> {
  + row : number
  + col : number
  + result : ShotResult
  + sunkShipName : string | null
}
class InvalidRequestError <<exception>> {
  + field : string
}
class JoinRefusedError <<exception>> {
  + reason : JoinError
}
class RateLimitedError <<exception>>
class NotSeatedError <<exception>>
class MoveRefusedError <<exception>>
class StaleGameError <<exception>>
class Game <<controller>> #F4F4F4;line.dashed;line:999999
class Lobby <<controller>> #F4F4F4;line.dashed;line:999999
class NetworkHandler <<boundary>> #F4F4F4;line.dashed;line:999999
class Timer <<boundary>> #F4F4F4;line.dashed;line:999999
class UIManager <<boundary>> #F4F4F4;line.dashed;line:999999

UIManager ..> Server : calls actions >
Timer ..> Server : claimTimeout() >
Server "1" --> "1" NetworkHandler : private messages via >
Server "1" *-- "1" RequestValidator : validates with >
Server "1" *-- "1" SessionManager : identifies caller with >
Server "1" *-- "1" RateLimiter : throttles with >
Server "1" *-- "1" GameRepository : loads / saves via >
Server "1" --> "0..*" Lobby : manages >
Server ..> Game : validates & resolves >
RequestValidator ..> InvalidRequestError : throws >
Server ..> JoinRefusedError : throws >
Server ..> RateLimitedError : throws >
Server ..> NotSeatedError : throws >
Server ..> PlayerView : builds >
PlayerView "1" *-- "0..*" ShotView
GameRepository ..> LoadedGame : returns >
GameRepository ..> MoveRefusedError : throws >
GameRepository ..> StaleGameError : throws >
GameRepository ..> Lobby : persists >
GameRepository ..> Game : persists >
note bottom of Server
  Stateless: every action runs
  RateLimiter -> RequestValidator (Zod)
  -> SessionManager.verifySeat()
  -> GameRepository load / write,
  so no client can change state directly.
  Games are saved with save_game(): one
  transaction, refused if another save
  landed first. A database trigger on
  games broadcasts after every write.
end note
legend bottom right
  Grey dashed boxes are classes detailed in another figure.
endlegend
@enduml
