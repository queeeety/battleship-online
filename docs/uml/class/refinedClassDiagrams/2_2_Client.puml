}
class NetworkHandler <<boundary>> {
  - channel : Channel | null
  - privateChannel : Channel | null
  - client : SupabaseClient
  - listener : NetworkListener
  - calls : ServerCalls
  - code : string | null
  - heartbeat : Interval | null
  + subscribe(code : string) : Promise<void>
  + unsubscribe() : Promise<void>
  + broadcast(g : Game) : void
  + trackPresence(p : HumanPlayer) : Promise<void>
  + onDisconnect(p : HumanPlayer) : void
  + sendPrivate(p : HumanPlayer, payload : PrivatePayload, code? : string) : Promise<void>
  + resync(code : string) : Promise<void>
  - startHeartbeat(code : string) : void
  - stopHeartbeat() : void
}
interface NetworkListener {
  + onBroadcast?(update : GameBroadcast) : void
  + onState?(view : PlayerView) : void
  + onError?(error : string) : void
  + onPresence?(onlineSessionIds : string[]) : void
  + onDisconnect?(p : HumanPlayer) : void
  + onPrivate?(payload : WirePrivatePayload) : void
}
class GameBroadcast <<value>> {
  + code : string
  + game_state : string | null
  + turn : 1 | 2 | null
  + shots_p1 : {row, col, result}[]
  + shots_p2 : {row, col, result}[]
  + winner : 1 | 2 | null
  + updated_at : string
}

class AudioManager <<boundary>> {
  - sounds : Map<SoundName, HTMLAudioElement>
  - muted : boolean
  + setMuted(muted : boolean) : void
  + isMuted() : boolean
  + play(sound : SoundName) : void
  + playForShot(result : ShotResult) : void
}

class Timer <<boundary>> {
  - limitMs : number
  - startedAt : Date | null
  + start(limitMs : number) : void
  + stop() : void
  + secondsLeft() : number
  + hasExpired() : boolean
}
abstract class Ability <<entity>> #F4F4F4;line.dashed;line:999999
class Board <<entity>> #F4F4F4;line.dashed;line:999999
class Game <<controller>> #F4F4F4;line.dashed;line:999999
class GameResult <<entity>> #F4F4F4;line.dashed;line:999999
class HumanPlayer <<entity>> #F4F4F4;line.dashed;line:999999
class Server <<controller>> #F4F4F4;line.dashed;line:999999

UIManager "1" *-- "2" BoardView : draws >
BoardView "1" *-- "100" CellView : made of >
UIManager "1" *-- "1" ShipPlacer : places fleet with >
UIManager "1" *-- "1" TurnBanner : shows turn in >
UIManager "1" *-- "1" AbilityCard : shows ability in >
UIManager "1" *-- "1" ResultScreen : ends game with >
UIManager "1" --> "0..1" Timer : counts down with >
