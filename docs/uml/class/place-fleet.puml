@startuml PlaceFleet_UseCaseClassDiagram
title Use Case: Place Fleet - Participating Classes

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

enum Orientation {
  HORIZONTAL
  VERTICAL
}

enum CellState {
  EMPTY
  OCCUPIED
  HIT
  MISS
}

enum GameState {
  PLACEMENT
  IN_PROGRESS
  FINISHED
}

enum PlacementError {
  OUT_OF_BOUNDS
  OVERLAPS_SHIP
  ALREADY_PLACED
  FLEET_INCOMPLETE
}

class UIManager <<boundary>> {
  + renderBoard(b : Board, isOwn : boolean) : void
  + onCellClick(c : Coordinate) : void
}

class Server <<controller>> {
  + placeShips(code : unknown, layout : unknown) : Promise<boolean>
}

class Game <<controller>> {
  - state : GameState
  + beginBattle() : void
}

abstract class Player <<entity>> {
  - id : UUID
  - name : String
  - isReady : boolean
  + placeFleet(b : Board) : void
  + confirmPlacement() : boolean
}

class HumanPlayer <<entity>>

class AIOpponent <<entity>>

class Board <<entity>> {
  - width : int = 10
  - height : int = 10
  - ships : List<Ship>
  + canPlace(s : Ship, start : Coordinate, o : Orientation) : boolean
  + placeShip(s : Ship, start : Coordinate, o : Orientation) : boolean
  + removeShip(s : Ship) : void
  + placeFleetRandomly() : void
  + isFleetComplete() : boolean
}

class Cell <<entity>> {
  - coordinate : Coordinate
  - state : CellState
  + occupy(s : Ship) : void
  + clear() : void
}

abstract class Ship <<entity>> {
  - name : String
  # length : int
  - orientation : Orientation
  - isPlaced : boolean
  + rotate() : void
  + occupies(c : Coordinate) : boolean
}

class Carrier {
  # length : int = 5
}
class Battleship {
  # length : int = 4
}
class Cruiser {
  # length : int = 3
}
class Submarine {
  # length : int = 3
}
class Destroyer {
  # length : int = 2
}

class Coordinate <<value>> {
  - x : int
  - y : int
  + isWithinBounds(w : int, h : int) : boolean
}

' ---------- Relationships ----------
UIManager ..> Board : renders / validates >
UIManager ..> Server : placeShips >
Server ..> Board : re-validates >
Server ..> Game : starts when both ready >

Game "1" o-- "2" Player : players >
Game --> GameState

Player <|-- HumanPlayer
Player <|-- AIOpponent
Player "1" *-- "1" Board : owns >

Board "1" *-- "100" Cell : consists of >
Board "1" o-- "5" Ship : fleet >
Board ..> PlacementError : rejects with >
Board ..> Coordinate : validates >

Ship <|-- Carrier
Ship <|-- Battleship
Ship <|-- Cruiser
Ship <|-- Submarine
Ship <|-- Destroyer
Ship --> Orientation

Cell "1" --> "1" Coordinate
Cell "*" --> "0..1" Ship : holds >
Cell --> CellState

note bottom of Board
  Board.canPlace() runs on the client for
  instant feedback, then Server.placeShips()
  calls the same method again: the client is
  never trusted with the layout (brief, 3.2.1).
end note

note right of AIOpponent
  Uses placeFleetRandomly() for its
  own fleet (same as the Randomise button).
end note

@enduml
