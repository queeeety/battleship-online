@startuml JoinLobby_UseCaseClassDiagram
title Use Case: Create / Join Lobby - Participating Classes

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

enum LobbyStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum JoinError {
  CODE_NOT_FOUND
  LOBBY_FULL
  GAME_ALREADY_FINISHED
  INVALID_NAME
}

enum GameState {
  PLACEMENT
  IN_PROGRESS
  FINISHED
}

enum GameType {
  BEGINNER
  ORIGINAL
  QUICK_FIRE
}


class UIManager <<boundary>> {
  - currentScreen : Screen
  + showScreen(s : Screen) : void
  + showError(e : JoinError) : void
}

class NetworkHandler <<boundary>> {
  - channel : Channel
  + subscribe(code : String) : void
  + trackPresence(p : HumanPlayer) : void
}

class Server <<controller>> {
  + createLobby(name : unknown, type : unknown) : Promise<Lobby>
  + joinLobby(code : unknown, name : unknown) : Promise<{lobby, player}>
  + restoreSeat(sessionId? : UUID) : Promise<{lobby, player} | null>
}

class SessionManager <<utility>> {
  + signInAnonymously() : Promise<UUID>
  + currentSessionId() : Promise<UUID | null>
}

class GameRepository <<persistence>> {
  + loadLobby(code : String) : Promise<Lobby | null>
  + saveLobby(l : Lobby) : Promise<void>
  + findActiveLobbyCode(sessionId : UUID) : Promise<String | null>
}

class JoinRefusedError <<exception>> {
  + reason : JoinError
}

class Lobby <<controller>> {
  - code : String
  - status : LobbyStatus
  - gameType : GameType
  - createdAt : DateTime
  + {static} generateCode() : String
  + {static} findByCode(code : String) : Lobby
  + join(name : String, sessionId : UUID) : HumanPlayer
  + seatOf(sessionId : UUID) : 1 | 2 | null
  + isFull() : boolean
  + isJoinable() : boolean
  + shareLink() : URL
  + abandon() : void
}

class Game <<controller>> {
  - id : UUID
  - state : GameState
  - gameType : GameType
  + addPlayer(p : Player) : boolean
}

abstract class Player <<entity>> {
  - id : UUID
  - name : String
  - isReady : boolean
}

class HumanPlayer <<entity>> {
  - sessionId : UUID
  - connected : boolean
  + disconnect(at : DateTime = now) : void
  + reconnect() : void
}

' ---------- Relationships ----------
UIManager ..> Server : createLobby / joinLobby >
UIManager ..> JoinError : displays >
NetworkHandler ..> UIManager : pushes updates >
Server "1" --> "0..*" Lobby : manages >
Server *-- SessionManager : identifies caller with >
Server *-- GameRepository : loads / saves via >
Server ..> JoinRefusedError : throws >
JoinRefusedError ..> JoinError
GameRepository ..> Lobby : persists >
SessionManager ..> HumanPlayer : issues sessionId >
NetworkHandler ..> HumanPlayer : tracks presence >

Lobby "1" o-- "0..2" HumanPlayer : seats >
Lobby "1" *-- "1" Game : runs >
Lobby --> LobbyStatus
Lobby --> GameType

Game "1" o-- "2" Player : players >
Game --> GameState
Game --> GameType

Player <|-- HumanPlayer

note bottom of Lobby
  Lobby lifecycle is shared state across
  both clients, so it resides on the
  server (brief, section 3.2.1).
  Code: 6 chars from A-Z / 2-9, without
  0, O, 1, I, L. Composition with Game:
  removing the lobby removes the game.
end note

note right of HumanPlayer
  sessionId comes from Supabase
  anonymous sign-in, so a mid-game
  refresh returns the player to their
  seat (Server.restoreSeat).
end note

@enduml
