@startuml
title MyBattleship - Use Case Diagram
skinparam linetype ortho
 
actor Timer
actor Host
actor Guest


rectangle "MyBattleship System" {
 
  rectangle "Getting into a Game" {
    usecase "Create Lobby" as CreateLobby
    usecase "Join Lobby" as JoinLobby
    usecase "Place Fleet" as PlaceFleet
    usecase "Randomise Fleet" as RandomiseFleet
  }
 
  rectangle "The turn" {
    usecase "Auto-fire on Timeout" as AutoFire
    usecase "Fire Shot" as FireShot
    usecase "Resolve Shot" as ResolveShot
    usecase "Take Turn" as TakeTurn
    usecase "Sink Ship" as SinkShip
    usecase "Game Over / Rematch" as GameOver
  }
 
  rectangle "Abilities" {
    usecase "Grant Ability" as GrantAbility
    usecase "Keep or Replace Ability" as KeepReplace
    usecase "Use Ability" as UseAbility
    usecase "Reroute" as Reroute
    usecase "Double Shot" as DoubleShot
    usecase "Line Scan" as LineScan
    usecase "Radar Sweep" as RadarSweep
  }
}
 
actor Attacker
actor Defender
 
Timer -- AutoFire
 
Host -- CreateLobby
Host -- PlaceFleet
Guest -- JoinLobby
Guest -- PlaceFleet
 
Defender -- KeepReplace
 
TakeTurn -- Attacker
 
RandomiseFleet ..> PlaceFleet : <<extend>>
 
AutoFire ..> FireShot : <<include>>
FireShot ..> TakeTurn : <<extend>>
FireShot ..> ResolveShot : <<include>>
ResolveShot ..> GameOver : <<extend>>
 
SinkShip ..> ResolveShot : <<extend>>
SinkShip ..> GrantAbility : <<include>>
GrantAbility ..> KeepReplace : <<extend>>
UseAbility ..> TakeTurn : <<extend>>
 
UseAbility <|-- Reroute
UseAbility <|-- DoubleShot
UseAbility <|-- LineScan
UseAbility <|-- RadarSweep
 
@enduml
 