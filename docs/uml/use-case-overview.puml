@startuml MyBattleship_UseCases
title MyBattleship – Use Case Diagram
left to right direction
skinparam nodesep 12
skinparam linetype ortho

actor Player

rectangle "MyBattleship Client (browser)" as Client {
  usecase "Start Game" as UC1
  usecase "Create Lobby" as Create
  usecase "Join Lobby" as Join
  usecase "Play vs AI" as AI
  usecase "Place Fleet" as UC2
  usecase "Fire Shot" as UC3
  usecase "Use Ability" as UC4
  usecase "Game Over / Rematch" as UC5
  usecase "Forfeit" as Forfeit
}

rectangle "MyBattleship Server" as Server {
  usecase "Generate Lobby Code" as GenCode
  usecase "Validate Lobby Code" as ValCode
  usecase "Validate Placement" as ValPlace
  usecase "Resolve Shot" as Resolve
  usecase "Grant Ability" as Grant
  usecase "Apply Ability Effect" as Apply
  usecase "Fire Random Shot" as RandShot
  usecase "Detect Disconnect" as Disconnect
  usecase "Build Game Result" as Result
}

actor Timer

Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4
Player --> UC5
Player --> Forfeit

UC1 <|-- Create
UC1 <|-- Join
UC1 <|-- AI

Create ..> GenCode : <<include>>
Join ..> ValCode : <<include>>
UC2 ..> ValPlace : <<include>>
UC3 ..> Resolve : <<include>>
UC4 ..> Apply : <<include>>
UC5 ..> Result : <<include>>

Forfeit ..> UC5 : <<include>>
Resolve <.. Grant : <<extend>>
UC3 <.. RandShot : <<extend>>
UC5 <.. Disconnect : <<extend>>

RandShot <-- Timer
Disconnect <-- Timer
@enduml