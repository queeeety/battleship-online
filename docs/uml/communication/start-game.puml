@startuml 6_1_StartGame_CommunicationDiagram
frame "sd StartGame" {
  actor "Cian\n(host)" as Host
  rectangle "hostUI : UIManager" as HostUI
  rectangle "ai : AIOpponent" as AI
  rectangle "game : Game" as Game
  rectangle "server : Server" as Server
  rectangle "net : NetworkHandler" as Net
  rectangle "lobby : Lobby" as Lobby
  rectangle "guestUI : UIManager" as GuestUI
  actor "Aoife\n(guest)" as Guest
  Host -down- HostUI : ↓ 1 [multiplayer] : enters name "Cian91", selects Create Lobby\n⇡ 1.2 [name length > 16] : showError(INVALID_NAME)\n⇡ 1.4 : showScreen(Lobby), shareLink()\n↓ 4 [single player] : selects Play vs AI, chooses NORMAL difficulty\n⇡ 4.7 : showScreen(Placement)
  Guest -down- GuestUI : ↓ 2 [multiplayer] : enters code "4F7K2M", leaves name blank\n⇡ 2.2 [lobby not found] : showError("Lobby not found")\n⇡ 2.3 [lobby.isFull()] : showError("Lobby is full")\n⇡ 2.4 [lobby.status == FINISHED] : showError("Game has ended")\n⇡ 2.5 [lobby.isJoinable()] : showScreen(Placement)
  HostUI -down- Net : ↓ 1.3 : subscribe("4F7K2M")\n⇡ 2.1.10.1 : both players seated
  GuestUI -down- Net : ⇡ 2.1.10.2 : both players seated
  HostUI -down- AI : ↓ 4.2 : <<create>> AIOpponent(NORMAL)
  HostUI -down- Server : ↓ 1.1 : createLobby(name, ORIGINAL)\n⇡ 1.1.1 [name length > 16] : JoinError.INVALID_NAME\n⇡ 1.1.5 : lobby, sessionId
  GuestUI -down- Server : ↓ 2.1 : joinLobby("4F7K2M", "")\n⇡ 2.1.2 [lobby not found] : JoinError.CODE_NOT_FOUND\n⇡ 2.1.3 [lobby.isFull()] : JoinError.LOBBY_FULL\n⇡ 2.1.4 [lobby.status == FINISHED] : JoinError.GAME_ALREADY_FINISHED\n⇡ 2.1.11 [lobby.isJoinable()] : lobby, sessionId\n↓ 3 [player reloads the page] : restoreSeat(sessionId)\n⇡ 3.2 : getMyState(code) : game
  HostUI -down- Game : ↓ 4.1 : <<create>> Game(gameType)\n⇡ 4.6 : state = PLACEMENT
  AI -- AI : 4.5 : placeFleetRandomly()
  Net -down- Server : ↑ 2.1.10 [lobby.isJoinable()] : broadcast(game)
  Server -- Server : 1.1.2 [name blank] : assignRandomName()\n2.1.5 [lobby.isJoinable()] : assignRandomName() : &#34;Player482&#34;
  Server -down- Lobby : ↓ 1.1.3 : <<create>> Lobby(gameType)\n⇡ 1.1.3.2 : lobby (code = "4F7K2M")\n↓ 1.1.4 : join("Cian91")\n⇡ 1.1.4.2 : hostPlayer : HumanPlayer\n↓ 2.1.1 : findByCode("4F7K2M")\n⇡ 2.1.1.1 : lobby\n↓ 2.1.6 [lobby.isJoinable()] : join("Player482")\n⇡ 2.1.6.1 : guestPlayer : HumanPlayer\n↓ 3.1 : findByCode("4F7K2M")
  Server -down- Game : ↓ 2.1.7 [lobby.isJoinable()] : <<create>> Game(gameType)\n↓ 2.1.8 [lobby.isJoinable()] : addPlayer(hostPlayer)\n↓ 2.1.9 [lobby.isJoinable()] : addPlayer(guestPlayer)\n⇡ 2.1.9.1 : state = PLACEMENT
  Lobby -- Lobby : 1.1.3.1 *[code already in use] : generateCode()\n1.1.4.1 : seat host as Player 1
  Game -- Game : 4.3 : addPlayer(humanPlayer)\n4.4 : addPlayer(ai)
}
@enduml
