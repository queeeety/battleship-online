@startuml 6_2_GameOverRematch_CommunicationDiagram
frame "sd GameOverRematch" {
  actor "Cian\n(winner)" as Winner
  actor "Aoife\n(loser)" as Loser
  rectangle "winnerUI : UIManager" as WinUI
  rectangle "net : NetworkHandler" as Net
  rectangle "loserUI : UIManager" as LoseUI
  rectangle "rematch : RematchRequest" as Rematch
  rectangle "server : Server" as Server
  actor "timer : Timer" as Timer
  rectangle "lobby : Lobby" as Lobby
  rectangle "game : Game" as Game
  rectangle "result : GameResult" as Result
  Loser -down- LoseUI : ↓ 2 [player selects Forfeit] : selects Forfeit\n⇡ 5.4.2.1 : "You lose", opponent layout revealed\n↓ 7 [opponent accepts] : selects Accept\n↓ 8 [opponent declines or does not answer] : selects Home
  Winner -down- WinUI : ⇡ 5.4.1.1 : "You win", opponent layout revealed\n↓ 6 : selects Rematch
  WinUI -down- Net : ⇡ 5.4.1 : showResult(winnerResult)\n⇡ 7.1.3.1 : showScreen(Placement)
  LoseUI -down- Net : ⇡ 5.4.2 : showResult(loserResult)\n⇡ 6.1.2.1 : "[Name] wants a rematch"\n⇡ 7.1.3.2 : showScreen(Placement)
  LoseUI -down- Server : ↓ 2.1 : forfeit(code)\n↓ 7.1 : requestRematch(code, true)\n↓ 8.1 : requestRematch(code, false)
  WinUI -down- Server : ↓ 6.1 : requestRematch(code, true)
  Net -down- Server : ↑ 6.1.2 : broadcast(game)\n↑ 7.1.3 : broadcast(game)
  Net -down- Game : ↓ 3 [no presence for 60 s] : onDisconnect(loser)\n↑ 5.4 : broadcast(game)
  Server -down- Game : ↓ 2.1.1 : forfeit(loser)
  Timer -down- Game : ↓ 4 [no presence for 60 s] : gracePeriodElapsed
  Server -down- Rematch : ↓ 6.1.1 : <<create>> RematchRequest(requestedBy = winner)\n⇡ 6.1.1.1 : status = REQUESTED\n↓ 7.1.1 : accept()\n⇡ 7.1.1.1 : isMutual() == true\n↓ 8.1.1 : decline()\n⇡ 8.1.1.1 : status = DECLINED\n↓ 9 [opponent is the AIOpponent] : accept()
  Server -down- Lobby : ↓ 7.1.2 : reset()\n↓ 8.1.2 : abandon()\n⇡ 8.1.2.1 : status = ABANDONED
  Game -- Game : 1 [last ship sunk] : checkWinCondition()\n1.1 : declareWinner(shooter, FLEET_DESTROYED)\n2.1.1.1 : declareWinner(opponent, OPPONENT_FORFEIT)\n4.1 : hasExceededGracePeriod()\n4.2 : declareWinner(opponent, OPPONENT_DISCONNECTED)\n5 : finishedAt = now, state = FINISHED
  Game -down- Result : ↓ 5.1 : <<create>> resultFor(winner)\n⇡ 5.1.2 : winnerResult\n↓ 5.2 : resultFor(loser)\n⇡ 5.2.1 : loserResult
  Game -down- Lobby : ↓ 5.3 : status = FINISHED\n↑ 7.1.2.1 : <<create>> new Game(same gameType)
  Result -- Result : 5.1.1 : didWin, shotsFired, accuracy, shipsSunk\nfrom the Shot history
}
@enduml
