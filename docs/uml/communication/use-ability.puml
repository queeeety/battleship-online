@startuml 6_4_UseAbility_CommunicationDiagram
frame "sd UseAbility" {
  actor "Aoife\n(ability holder)" as Owner
  rectangle "ownerUI : UIManager" as UI
  rectangle "net : NetworkHandler" as Net
  rectangle "oppUI : UIManager" as OppUI
  rectangle "server : Server" as Server
  rectangle "game : Game" as Game
  rectangle "owner : Player" as Player
  rectangle "ability : Ability" as Ability
  rectangle "ownBoard : Board" as OwnBoard
  rectangle "oppBoard : Board" as OppBoard
  Owner -down- UI : ⇡ 1.4.1.1 : "Keep current or take drawn?"\n↓ 2 [owner already holds an unused ability] : selects Keep\n↓ 4 : selects Radar Sweep, targets area E4-G6\n⇡ 4.2 [not ability.isValidTarget(oppBoard, E4)] : choose another target (UC4 4a)\n⇡ 4.3 : green scan markers on F5, F6
  UI -down- Net : ⇡ 1.4.1 : promptKeepOrReplace(current, drawn)\n⇡ 4.1.3.1 : showScanResult([F5, F6])
  OppUI -down- Net : ⇡ 3.1 : "[Name] was granted an ability"\n⇡ 4.1.4.1 : &#34;[Name] used Radar Sweep&#34;
  UI -down- Server : ↓ 2.1 : chooseAbility(code, true)\n↓ 4.1 : useAbility(code, ability, E4)\n⇡ 4.1.2 [not ability.isValidTarget(oppBoard, E4)] : reject\n⇡ 4.1.5 : ok
  Net -down- Server : ↑ 4.1.3 : sendPrivate(owner, [F5, F6])\n↑ 4.1.4 : broadcast(game)
  Net -down- Game : ↑ 1.4 [owner already holds an unused ability] : sendPrivate(owner, [current, drawn])\n↑ 3 : broadcast(game)
  Server -down- Game : ↓ 4.1.1 : applyAbility(owner, E4)\n⇡ 4.1.1.2 [not ability.isValidTarget(oppBoard, E4)] : invalid target\n⇡ 4.1.1.6 : result
  Server -down- Player : ↓ 2.1.1 : receiveAbility(kept)
  Game -- Game : 1 : grantAbility(owner)\n1.1 *[drawn == Reroute and Reroute.validPositions(ownBoard, s).isEmpty()\n         for every undamaged Ship] : draw again from the other three\n4.1.1.4 [valid target and ability.usesTurnShot] : switchTurn()\n4.1.1.5 [valid target and not ability.usesTurnShot] : turn continues, player still fires\n5 [holder is the AIOpponent] : AIOpponent.shouldUseAbility()
  Game -down- Ability : ↓ 1.2 : <<create>> RadarSweep\n↓ 4.1.1.1 : canUse(game)\n⇡ 4.1.1.1.1 : owner's turn, before firing, not used\n↓ 4.1.1.3 [valid target] : apply(game, oppBoard, E4)\n↑ 4.1.1.3.5 [ability is DoubleShot] : doubleShotActive = true\n⇡ 4.1.1.3.6 : applied, used = true
  Game -down- Player : ↓ 1.3 [owner.heldAbility == null] : receiveAbility(drawn)\n⇡ 1.3.1 : held
  Ability -down- OppBoard : ↓ 4.1.1.3.1 [ability is RadarSweep] : scanArea(E4, 3)\n⇡ 4.1.1.3.1.1 : [F5, F6] unshot ship squares\n↓ 4.1.1.3.2 [ability is LineScan] : scanLine(index, isRow)\n⇡ 4.1.1.3.2.1 : unshot ship squares on that line
  Ability -down- OwnBoard : ↓ 4.1.1.3.3 [ability is Reroute] : validPositions(ownBoard, ship)\n↓ 4.1.1.3.4 [ability is Reroute] : moveShip(ship, start, orientation)
}
@enduml
